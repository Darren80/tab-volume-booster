{
  "manifest_version": 3,
  "name": "Crescendo — Tab Volume Booster",
  "version": "1.2.6",
  "description": "Boost the volume of the current tab up to 1200%, with Voice and Bass presets. Control it with the slider or arrow keys.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Crescendo — Tab Volume Booster",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "crescendo@darren.ohonba",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
